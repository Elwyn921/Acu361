{
  "name": "acu361-site",
  "private": true,
  "version": "1.0.0",
  "description": "Website and 3D explorer of the Acu361 dataset",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "assets": "node scripts/prepare.mjs",
    "dev": "node scripts/prepare.mjs --if-missing && vite",
    "build": "node scripts/prepare.mjs --if-missing && tsc --noEmit && vite build",
    "preview": "vite preview",
    "figures": "node scripts/make_figures.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/three": "0.179.0",
    "gltfpack": "1.3.0",
    "meshoptimizer": "1.3.0",
    "playwright-core": "1.60.0",
    "terser": "5.51.2",
    "three": "0.179.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
